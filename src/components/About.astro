---
import { getCollection } from 'astro:content';
import type { Language } from '../schemas';
import { aboutText, settings, siteText, timelineText } from '../lib/content';
import SectionNavigation from './SectionNavigation.astro';
import Timeline from './Timeline.astro';
import '../styles/timeline.css';

interface Props { language: Language }
const { language } = Astro.props;
const about = await settings('about');
const { contact } = about;
const site = await settings('site');
const localizedAbout = (await aboutText(about.text, language)).data;
const localizedSite = (await siteText(site.text, language)).data;
const timelines = (await getCollection('timelines')).sort((a, b) => a.data.order - b.data.order);
const sections = await Promise.all(timelines.map(async (timeline) => ({
  timeline,
  text: (await timelineText(timeline, language)).data,
})));
const navigationGroups = sections.map(({ timeline, text }) => ({
  label: text.title,
  href: timeline.id === 'experience' ? undefined : `#${timeline.id}`,
  entries: (timeline.id === 'experience' ? timeline.data.organizations : []).map((organization) => ({
    id: `${timeline.id}-${organization.id}`,
    title: text.organizations[organization.id],
  })),
}));
---
<div class="portfolio-page about-page">
  <SectionNavigation heading={localizedSite.navigation.about} groups={navigationGroups} />
  <div class="projects about-content">
    <h1 class="visually-hidden">{localizedSite.navigation.about}</h1>
    <div class="about-header">
      <p class="about-contact">{localizedAbout.contact.prefix} <a href={contact.href}>{contact.label}</a></p>
    </div>
    {sections.map(({ timeline }) => <Timeline timeline={timeline} language={language} technologiesLabel={localizedSite.labels.technologies} />)}
  </div>
</div>
