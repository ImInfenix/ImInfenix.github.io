---
import { getCollection } from 'astro:content';
import type { Language } from '../schemas';
import { aboutText, settings, siteText } from '../lib/content';
import Timeline from './Timeline.astro';
import '../styles/timeline.css';

interface Props { language: Language }
const { language } = Astro.props;
const about = await settings('about');
const { contact } = about;
const site = await settings('site');
const localizedAbout = (await aboutText(about.text, language)).data;
const localizedSite = (await siteText(site.text, language)).data;
const timelines = (await getCollection('timelines')).sort((a, b) => a.data.order - b.data.order);
---
<section class="brick about-intro">
  <p>{localizedAbout.contact.prefix} <a class="contact" href={contact.href}>{contact.label}</a></p>
</section>
{timelines.map((timeline) => <Timeline timeline={timeline} language={language} technologiesLabel={localizedSite.labels.technologies} />)}
