---
import { render } from 'astro:content';
import type { Language } from '../schemas';
import { homeText, settings } from '../lib/content';
import { assetUrl } from '../lib/site';
import '../styles/resume.css';

interface Props { language: Language }
const { language } = Astro.props;
const homeSettings = await settings('home');
const translation = await homeText(homeSettings.text, language);
const Content = (await render(translation)).Content;
---
<section class="brick home">
  <h1>{translation.data.heading}</h1>
  <Content />
  <div class="resume">
    <a href={assetUrl(translation.data.resume.document)}>{translation.data.resume.label}<span aria-hidden="true"> ↗</span></a>
  </div>
</section>
