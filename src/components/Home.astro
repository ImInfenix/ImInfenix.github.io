---
import { render } from 'astro:content';
import type { Language } from '../schemas';
import { homeText, settings } from '../lib/content';
import { assetUrl } from '../lib/site';
import '../styles/resume.css';

interface Props { language: Language }
const { language } = Astro.props;
const data = await settings('home');
const localized = await homeText(data.text, language);
const Content = (await render(localized)).Content;
---
<section class="brick home">
  <h1>{localized.data.heading}</h1>
  <Content />
  <div class="resume">
    <a href={assetUrl(localized.data.resume.document)}>{localized.data.resume.label}<span aria-hidden="true"> ↗</span></a>
  </div>
</section>
