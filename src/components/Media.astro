---
import { Image } from 'astro:assets';
import type { PortfolioEntry } from '../lib/content';

interface Props {
  media: NonNullable<PortfolioEntry['data']['media']>;
  caption: string;
  alt?: string;
}
const { media, caption, alt } = Astro.props;
---
<figure class="portfolio-media">
  {media.type === 'video' ? (
    <iframe src={media.src} title={caption} width="560" height="315" loading="lazy" allowfullscreen></iframe>
  ) : typeof media.src === 'string' ? (
    <img src={media.src} alt={alt!} loading="lazy" decoding="async" />
  ) : (
    <Image src={media.src} alt={alt!} widths={[320, 640, 960]} sizes="(max-width: 1000px) 76vw, 56vw" loading="lazy" />
  )}
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .portfolio-media {
    margin: 0;
    min-width: 0;
  }

  .portfolio-media :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
    border-radius: .65rem;
  }

  iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: .65rem;
  }

  figcaption {
    margin: .6rem 0 0;
    color: var(--text-muted);
    font-size: .85rem;
  }
</style>
