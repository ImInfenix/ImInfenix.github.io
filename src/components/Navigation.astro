---
import type { CollectionEntry } from 'astro:content';
import type { Language, Page } from '../schemas';
import LanguageSelector from './LanguageSelector.astro';
import { siteText } from '../lib/content';
import { assetUrl, pageUrl } from '../lib/site';

interface Props {
  site: CollectionEntry<'site'>['data'];
  language: Language;
  page: Page;
}
const { site, language, page } = Astro.props;
const localized = (await siteText(site.text, language)).data;
---
<header class="site-header">
  <nav class="primary-nav" aria-label={localized.labels.navigation}>
    <a class="logo" href={pageUrl('index', language)} aria-label={localized.navigation.index}>
      <img src={assetUrl(site.logo)} alt="" width="64" height="64" />
      <span aria-hidden="true">{site.title}</span>
    </a>
    <ul class="page-links">
      {site.navigation.map((item) => (
        <li>
          <a href={pageUrl(item.id, language)} aria-current={page === item.id ? 'page' : undefined}>
            {localized.navigation[item.id]}
          </a>
        </li>
      ))}
    </ul>
    <LanguageSelector language={language} page={page} label={localized.labels.languages} />
  </nav>
</header>
