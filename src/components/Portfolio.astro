---
import { getCollection } from 'astro:content';
import type { Language } from '../schemas';
import { portfolioText, settings, siteText } from '../lib/content';
import PortfolioItem from './PortfolioItem.astro';
import SectionNavigation from './SectionNavigation.astro';

interface Props { collection: 'projects' | 'games'; language: Language }
const { collection, language } = Astro.props;
const portfolioItems = (await getCollection(collection)).sort((first, second) =>
  second.data.year - first.data.year || first.data.order - second.data.order
);
const localizedItems = await Promise.all(portfolioItems.map(async (item) => ({
  item,
  title: (await portfolioText(item, language)).data.title,
})));
const years = [...new Set(portfolioItems.map((item) => item.data.year))];
const yearGroups = years.map((year) => ({ year, entries: localizedItems.filter(({ item }) => item.data.year === year) }));
const navigationGroups = yearGroups.map(({ year, entries }) => ({
  label: String(year),
  entries: entries.map(({ item, title }) => ({ id: item.id, title })),
}));
const site = await settings('site');
const heading = (await siteText(site.text, language)).data.navigation[collection];
---
<div class="portfolio-page">
  <SectionNavigation heading={heading} groups={navigationGroups} />
  <div class="portfolio-content">
    <h1 class="visually-hidden">{heading}</h1>
    {yearGroups.map(({ year, entries }) => (
      <section class="portfolio-year-section" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="portfolio-year-heading">{year}</h2>
        {entries.map(({ item }) => <PortfolioItem entry={item} language={language} />)}
      </section>
    ))}
  </div>
</div>
