---
import type { Language } from '../schemas';
import { portfolioText, type PortfolioEntry } from '../lib/content';
import Media from './Media.astro';

interface Props { entry: PortfolioEntry; language: Language }
const { entry, language } = Astro.props;
const item = entry.data;
const localized = await portfolioText(entry, language);
const Content = localized.Content;
---
<section class:list={['project', 'portfolio-index-target', { 'project-with-media': !!item.media }]} id={entry.id} aria-labelledby={`${entry.id}-title`} tabindex="-1">
  <h3 id={`${entry.id}-title`}>{localized.data.title}</h3>
  {item.media && <Media media={item.media} caption={localized.data.media!.caption} alt={localized.data.media?.alt} />}
  <div class="prose"><Content /></div>
  {item.links.length > 0 && (
    <ul class="project-links">
      {item.links.map((link) => (
        <li>
          {link.type === 'link'
            ? <a href={localized.data.links![link.id].href ?? link.href} class="box-link" target="_blank" rel="noopener noreferrer">{localized.data.links![link.id].text}</a>
            : <img src={link.src} alt={localized.data.links![link.id].text} loading="lazy" />}
        </li>
      ))}
    </ul>
  )}
</section>
