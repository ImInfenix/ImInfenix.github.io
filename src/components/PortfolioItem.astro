---
import type { Language } from '../schemas';
import { portfolioText, type PortfolioEntry } from '../lib/content';
import Media from './Media.astro';

interface Props { entry: PortfolioEntry; language: Language }
const { entry, language } = Astro.props;
const metadata = entry.data;
const translation = await portfolioText(entry, language);
const Content = translation.Content;
const localizedLinks = metadata.links.map((link) => {
  const translatedLink = translation.data.links?.[link.id];
  if (!translatedLink) throw new Error(`${entry.id} : libellé absent (${link.id})`);
  return link.type === 'link'
    ? { type: 'link' as const, href: translatedLink.href ?? link.href, text: translatedLink.text }
    : { type: 'badge' as const, src: link.src, text: translatedLink.text };
});
---
<section class:list={['project', 'portfolio-index-target', { 'project-with-media': !!metadata.media }]} id={entry.id} aria-labelledby={`${entry.id}-title`} tabindex="-1">
  <h3 id={`${entry.id}-title`}>{translation.data.title}</h3>
  {metadata.media && <Media media={metadata.media} caption={translation.data.media!.caption} alt={translation.data.media?.alt} />}
  <div class="prose"><Content /></div>
  {localizedLinks.length > 0 && (
    <ul class="project-links">
      {localizedLinks.map((link) => (
        <li>
          {link.type === 'link'
            ? <a href={link.href} class="box-link" target="_blank" rel="noopener noreferrer">{link.text}</a>
            : <img src={link.src} alt={link.text} loading="lazy" />}
        </li>
      ))}
    </ul>
  )}
</section>
