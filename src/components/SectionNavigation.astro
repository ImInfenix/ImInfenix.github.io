---
import '../styles/project.css';

interface NavigationGroup {
  label: string;
  href?: string;
  entries: { id: string; title: string }[];
}
interface Props { heading: string; groups: NavigationGroup[] }
const { heading, groups } = Astro.props;
const firstGroup = groups.find((group) => group.entries.length > 0);
const firstEntry = firstGroup?.entries[0];
const initialMobileLabel = firstEntry ? `${firstGroup.label} · ${firstEntry.title}` : firstGroup?.label;
---
<aside class="portfolio-navigation">
  <nav class="portfolio-index" aria-label={heading}>
    <p class="portfolio-index-heading">{heading}</p>
    <ol class="portfolio-index-list">
      {groups.map(({ label, href, entries }) => (
        <li class="portfolio-index-group">
          {href ? <a class="portfolio-index-group-label portfolio-index-group-link" href={href}>{label}</a> : <span class="portfolio-index-group-label">{label}</span>}
          {entries.length > 0 && <ol>
            {entries.map(({ id, title }) => <li><a href={`#${id}`}>{title}</a></li>)}
          </ol>}
        </li>
      ))}
    </ol>
  </nav>
  <details class="portfolio-mobile-navigation">
    <summary>
      <span class="portfolio-mobile-label">{heading}</span>
      <span class="portfolio-mobile-current">{initialMobileLabel}</span>
      <span class="portfolio-mobile-chevron" aria-hidden="true"></span>
    </summary>
    <nav aria-label={heading}>
      <ol class="portfolio-mobile-list">
        {groups.map(({ label, href, entries }) => (
          <li class="portfolio-index-group">
            {href ? <a class="portfolio-index-group-label portfolio-index-group-link" href={href}>{label}</a> : <span class="portfolio-index-group-label">{label}</span>}
            {entries.length > 0 && <ol>
              {entries.map(({ id, title }) => <li><a href={`#${id}`} data-group={label}>{title}</a></li>)}
            </ol>}
          </li>
        ))}
      </ol>
    </nav>
  </details>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.portfolio-page').forEach((contentPage) => {
    const navigationTargets = Array.from(contentPage.querySelectorAll<HTMLElement>('.portfolio-index-target'));
    const desktopLinks = Array.from(contentPage.querySelectorAll<HTMLAnchorElement>('.portfolio-index a'));
    const desktopList = contentPage.querySelector<HTMLOListElement>('.portfolio-index-list');
    const mobileMenu = contentPage.querySelector<HTMLDetailsElement>('.portfolio-mobile-navigation');
    const mobileLinks = Array.from(contentPage.querySelectorAll<HTMLAnchorElement>('.portfolio-mobile-list a'));
    const mobileCurrent = contentPage.querySelector<HTMLElement>('.portfolio-mobile-current');
    let scheduledFrame = 0;

    const updateActiveLink = () => {
      scheduledFrame = 0;
      const readingLine = Math.min(window.innerHeight * .38, 280);
      const nextTarget = navigationTargets.findIndex((target) => target.getBoundingClientRect().bottom > readingLine);
      const activeIndex = nextTarget === -1 ? navigationTargets.length - 1 : nextTarget;
      if (activeIndex < 0) return;

      for (const navigationLinks of [desktopLinks, mobileLinks]) {
        navigationLinks.forEach((link, index) => {
          if (index === activeIndex) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
      if (mobileCurrent && mobileLinks[activeIndex]) {
        const activeLink = mobileLinks[activeIndex];
        mobileCurrent.textContent = activeLink.dataset.group
          ? `${activeLink.dataset.group} · ${activeLink.textContent}`
          : activeLink.textContent;
      }

      if (desktopList && desktopLinks[activeIndex] && desktopList.scrollHeight > desktopList.clientHeight) {
        const activeLink = desktopLinks[activeIndex];
        const relativeTop = activeLink.getBoundingClientRect().top - desktopList.getBoundingClientRect().top + desktopList.scrollTop;
        desktopList.scrollTop = relativeTop - (desktopList.clientHeight - activeLink.clientHeight) / 2;
      }
    };

    const scheduleUpdate = () => {
      if (!scheduledFrame) scheduledFrame = requestAnimationFrame(updateActiveLink);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    mobileMenu?.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>('.portfolio-mobile-list a')
        : null;
      if (link) {
        const target = document.getElementById(link.hash.slice(1));
        mobileMenu.open = false;
        requestAnimationFrame(() => target?.focus({ preventScroll: true }));
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (mobileMenu?.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
        mobileMenu.open = false;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu?.open) {
        mobileMenu.open = false;
        mobileMenu.querySelector('summary')?.focus();
      }
    });
    scheduleUpdate();
  });
</script>
