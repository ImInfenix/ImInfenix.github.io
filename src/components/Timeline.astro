---
import { getEntry, type CollectionEntry } from 'astro:content';
import type { Language } from '../schemas';
import { timelineEntryText, timelineText } from '../lib/content';
import { assetUrl } from '../lib/site';

interface Props {
  timeline: CollectionEntry<'timelines'>;
  language: Language;
  technologiesLabel: string;
}
const { timeline, language, technologiesLabel } = Astro.props;
const translation = (await timelineText(timeline, language)).data;
const isProfessionalExperience = timeline.id === 'experience';
const localizedOrganizations = await Promise.all(timeline.data.organizations.map(async (organization) => ({
  ...organization,
  entries: await Promise.all(organization.entries.map(async (reference) => {
    const entry = await getEntry(reference);
    if (!entry) throw new Error(`${timeline.filePath} : expérience absente (${reference.id})`);
    const entryTranslation = await timelineEntryText(entry, language);
    return {
      translation: entryTranslation.data,
      Content: entryTranslation.body?.trim() ? entryTranslation.Content : undefined,
    };
  })),
})));
---
<section class:list={['brick', 'timeline-section', { 'portfolio-index-target': !isProfessionalExperience }]} id={timeline.id} aria-labelledby={`${timeline.id}-title`} tabindex={!isProfessionalExperience ? -1 : undefined}>
  <h2 id={`${timeline.id}-title`}>{translation.title}</h2>
  <ol class="timeline">
    {localizedOrganizations.map((organization) => (
      <li class:list={['timeline-card', { 'portfolio-index-target': isProfessionalExperience }]} id={`${timeline.id}-${organization.id}`} tabindex={isProfessionalExperience ? -1 : undefined}>
        <div class="timeline-content">
          {isProfessionalExperience && <h3 class="organization-name">{translation.organizations[organization.id]}</h3>}
          {organization.logo && <img class="organization-logo" src={assetUrl(organization.logo)} alt={isProfessionalExperience ? '' : translation.organizations[organization.id]} loading="lazy" />}
          {organization.entries.map(({ translation: entryTranslation, Content }) => (
            <div class="timeline-entry">
              {isProfessionalExperience ? <h4>{entryTranslation.period}</h4> : <h3>{entryTranslation.period}</h3>}
              {entryTranslation.duration && <p class="duration">{entryTranslation.duration}</p>}
              {entryTranslation.role && <p>{entryTranslation.role}</p>}
              {Content && <div class="prose"><Content /></div>}
            </div>
          ))}
          {organization.technologies && (
            <div class="technologies">
              <h3>{technologiesLabel}</h3>
              <p>{organization.technologies.join(' ')}</p>
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
