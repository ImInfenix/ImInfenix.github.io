---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { siteText, validateContent } from '../lib/content';
import { assetUrl, pageUrl } from '../lib/site';
import { languages, type Language, type Page } from '../schemas';
import '../styles/main.css';

interface Props {
  language: Language;
  page: Page;
}
const { language, page } = Astro.props;
const site = await validateContent();
const localizedSite = (await siteText(site.text, language)).data;
const pageLabel = localizedSite.navigation[page];
const documentTitle = page === 'index' ? site.title : `${pageLabel} | ${site.title}`;
const canonicalUrl = new URL(pageUrl(page, language), Astro.site);
const websiteStructuredData = { '@context': 'https://schema.org/', '@type': 'WebSite', name: site.title, url: Astro.site?.href };
---
<!DOCTYPE html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={localizedSite.descriptions[page]} />
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((locale) => (
      <link rel="alternate" hreflang={locale} href={new URL(pageUrl(page, locale), Astro.site)} />
    ))}
    <link rel="icon" href={assetUrl(site.favicon)} type="image/x-icon" />
    {page === 'index' && <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{localizedSite.labels.skip}</a>
    <Navigation site={site} language={language} page={page} />
    <main id="main-content" class:list={{ 'home-page': page === 'index' }} tabindex="-1">
      <slot />
    </main>
    {page !== 'index' && <BackToTop label={localizedSite.labels.backToTop} />}
    <Footer site={site} language={language} />
  </body>
</html>
